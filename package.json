{
  "name": "kahaan", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node backend/local-server.mjs",
    "build": "node scripts/sync-data.mjs && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "node --test --test-isolation=none backend/tests/*.test.mjs",
    "fetch:osm": "node scripts/fetch-osm.mjs",
    "seed": "node scripts/seed-dynamo.mjs"
  },
  "dependencies": {"@aws-sdk/client-dynamodb": "^3.0.0", "@aws-sdk/lib-dynamodb": "^3.0.0"}
}
